# Serveur
NODE_ENV=development
PORT=3000

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=piscine_user
DB_PASSWORD=
DB_NAME=piscine

# JWT
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — URL exacte du frontend (pas de wildcard)
CORS_ORIGIN=https://localhost:4200

# HTTPS (optionnel en développement, obligatoire en production)
# Générer un cert auto-signé : openssl req -x509 -newkey rsa:4096 -keyout key.pem -out cert.pem -days 365 -nodes
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem
